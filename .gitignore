# Базите на приложението — цялата папка, не само *.db: там падат и
# автоматичните бекъпи (lives.db.bak-ГГГГММДД-ЧЧММСС), които са десетки
# мегабайта и нямат работа в хранилището.
assets/db/

# Произведената база се прави наново от tools/calendar_gen — не се пази.
tools/calendar_gen/out/

# Изходната база (семето за генератора) — копие на assets/db/calendar_old.db,
# пазено отделно, за да можем да презаписваме assets/db/ с генерирани
# резултати, без да губим оригинала. Самата input/ папка (вкл. текстовия
# файл с правилата за поста) си остава в git — само базата в нея не.
tools/calendar_gen/input/db/*.db

# Преводът на житията от .epub — изходните книги, работните разглобявания и
# готовите томове са тежки и се възпроизвеждат от скриптовете.
tools/Translate_lives/
