# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Готови пакети за раздаване — APK/AAB и архивите около тях. `/build/`
# по-горе покрива обичайното им място, но при ръчно копиране в корена (за
# сваляне през TeamViewer например) те оставаха незащитени и автоматичният
# "backup" комит ги грабваше.
*.apk
*.aab
*.zip

# Базите на приложението — цялата папка, не само *.db: там падат и
# автоматичните бекъпи (lives.db.bak-ГГГГММДД-ЧЧММСС), които са десетки
# мегабайта и нямат работа в хранилището.
assets/db/

# Произведената база се прави наново от tools/calendar_gen — не се пази.
tools/calendar_gen/out/

# Изходната база (семето за генератора) — копие на assets/db/calendar_old.db,
# пазено отделно, за да можем да презаписваме assets/db/ с генерирани
# резултати, без да губим оригинала. Самата input/ папка (вкл. текстовия
# файл с правилата за поста) си остава в git — само папката с базата не.
# ЦЯЛАТА папка, а не само *.db: там падат и резервните копия
# (calendar_old.db.bak-ГГГГММДД-ЧЧММСС), които иначе оставаха незащитени.
tools/calendar_gen/input/db/

# Преводът на житията от .epub — изходните книги, работните разглобявания и
# готовите томове са тежки и се възпроизвеждат от скриптовете.
tools/Translate_lives/

# Преводът на четивата за "Справочник": скриптовете и входните текстове
# ОСТАВАТ в git — извън него са само ключът и междинните файлове, които се
# правят наново от самите скриптове.
tools/reference_gen/Translate/.env
tools/reference_gen/Translate/work/

# Преводът на „Мисли на всеки ден" на свт. Теофан Затворник — по същото
# правило: скриптовете и изходният .epub ОСТАВАТ в git (той е 800 KB и е
# първоизточникът), извън него са междинните разглобявания и преводите,
# които се правят наново от самите скриптове.
tools/translate_Teofan/work/
