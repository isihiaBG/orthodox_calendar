# Готови пакети за раздаване — APK/AAB и архивите около тях. `/build/`
# по-горе покрива обичайното им място, но при ръчно копиране в корена (за
# сваляне през TeamViewer например) те оставаха незащитени и автоматичният
# "backup" комит ги грабваше.
*.apk
*.aab
*.zip

# Базите на приложението — цялата папка, не само *.db: там падат и
# автоматичните бекъпи (lives.db.bak-ГГГГММДД-ЧЧММСС), които са десетки
# мегабайта и нямат работа в хранилището.
assets/db/

# Илюстрациите към житията на българските светии — 91 файла, ~9,5 MB.
# Свалени от изворите и подредени от tools/lives_bg/ и tools/lives_extra/.
# Извън git по същите съображения като базите: двоични са и се менят при
# всяко прекарване на конвейерите.
#
# ⚠ Папката Е в pubspec.yaml — тоест ВЛИЗА в APK-то. Двете не си
# противоречат, както при кориците по-долу.
#
# ⚠ И двата конвейера, които я пълнят, са ИЗВЪН git — тъй че изтрие ли се
# папката, съдържанието ѝ не се възстановява от хранилището. Връща се само
# с ново прекарване по мрежата (`04_fetch.py` + `08_images.py` в lives_bg,
# `apply.py` в lives_extra), и то ако изворните сайтове са налице. Пази я
# заедно с базите.
assets/lives_images/

# Томовете за „Читанка" — 19 MB .epub, произведени от tools/Translate_lives/.
# Извън git по същата причина като базите: двоични са, тежки са и се менят
# при всяка поправка по превода. Оригиналите живеят в Output/ на конвейера.
assets/books/

# Кориците за библиотеката — извлечени от самите томове с
# tools/extract_covers.py. Производни са: изтрият ли се, един ред ги връща,
# докато .epub-ите са налице. В git биха били второ копие на нещо, което
# вече е извън него.
#
# ⚠ Папката е в .gitignore, но Е в pubspec.yaml — тоест ВЛИЗА в APK-то.
# Двете не си противоречат: git пази хранилището от производни двоични
# файлове, а пакетът има нужда от тях, за да се отваря библиотеката
# мигновено.
assets/books_covers/

# Кориците на самия календар — по същите съображения.
assets/calendar_covers/

# Кориците на трите книги в „Библия" (въвеждащият екран на секцията).
#
# ⚠ За разлика от books_covers/ тези НЕ СА производни — рисувани са на ръка и
# няма скрипт, който да ги върне. Извън git са като другите корици (двоични,
# тежки), но затова пък оригиналите трябва да се пазят отделно: изтрие ли се
# папката, въвеждащият екран остава без изображения и няма откъде да се
# сглобят наново.
assets/bible_covers/

# Конвейерът за българския текст на Библията (pravoslavieto.com).
#
# Извън git като tools/azbyka.ru/ и tools/match_dmitry_lives/ — по същите
# съображения: 227 свалени страници и 77 разчетени файла са производни и
# тежки (19 MB), а резервните копия на базата в backup/ са двоични.
#
# ⚠ Изделието Е в git — поправките влизат направо в `assets/db/bible.db`,
# която се пази. Тук остава само начинът, по който са направени.
#
# ⚠ Затова пък README.md е ЕДИНСТВЕНИЯТ запис на находките: четирите различни
# шаблона на източника, двете кодировки, прагът за Псалтира. Изтрие ли се
# папката, това знание си отива с нея — при нужда се пази отделно.
tools/bible_bg/

# Конвейерът за житията на българските светии (pravoslavieto.com).
#
# Извън git по същите съображения като tools/bible_bg/ — същият сайт, същото
# устройство: cache/ пази свалените страници ДОСЛОВНО (тежки, производни), а
# work/ е разчетеното от тях.
#
# ⚠ Изделието Е в git — готовите жития влизат в `assets/db/lives.db`, която се
# пази. Тук остава само начинът, по който са направени.
#
# ⚠ input/ обаче НЕ е производна: там стоят ръчните съответствия
# (светия → страница в сайта), решени с око там, където засечката по дата и
# име не стига. Изтрие ли се папката, те се правят наново на ръка — затова
# README.md и input/ трябва да се пазят отделно, преди да се чисти каквото и
# да е тук.
tools/lives_bg/

# Произведената база се прави наново от tools/calendar_gen — не се пази.
tools/calendar_gen/out/

# Изходната база (семето за генератора) — копие на assets/db/calendar_old.db,
# пазено отделно, за да можем да презаписваме assets/db/ с генерирани
# резултати, без да губим оригинала. Самата input/ папка (вкл. текстовия
# файл с правилата за поста) си остава в git — само папката с базата не.
# ЦЯЛАТА папка, а не само *.db: там падат и резервните копия
# (calendar_old.db.bak-ГГГГММДД-ЧЧММСС), които иначе оставаха незащитени.
tools/calendar_gen/input/db/

# Преводът на житията от .epub. Изходните книги, работните разглобявания и
# готовите томове са тежки и се възпроизвеждат от скриптовете — те остават
# извън git. САМИТЕ СКРИПТОВЕ обаче влизат: без тях дванадесетте тома не
# могат да се произведат наново и цялата работа по конвейера би живяла само
# на един диск.
#
# Изключва се СЪДЪРЖАНИЕТО на папката, а не самата папка — от изцяло
# игнорирана папка git не позволява да се върне подпапка.
tools/Translate_lives/*
!tools/Translate_lives/scripts/
tools/Translate_lives/scripts/__pycache__/

# Ключовете за платените API-та — НИКЪДЕ и под никаква форма. Правилото е
# общо и стои преди частните, за да важи и за конвейери, които още не са
# написани. Самите скриптове носят само ИМЕТО на променливата
# (DEEPSEEK_API_KEY) и пътя, откъдето да я прочетат; стойността живее в
# ~/Desktop/azbyka.ru/.env, извън хранилището.
.env
**/.env

# Преводът на четивата за "Справочник": скриптовете и входните текстове
# ОСТАВАТ в git — извън него са само междинните файлове, които се правят
# наново от самите скриптове.
tools/reference_gen/Translate/work/

# Преводът на „Мисли на всеки ден" на свт. Теофан Затворник — в git остават
# САМО скриптовете. Междинните разглобявания и преводите се правят наново от
# тях, а изходната книга е извън хранилището по авторски съображения (виж
# бележката при Оптина по-долу). Тя беше вътре до 14.08.2026 и е изтрита и
# от историята — не я връщай.
tools/translate_Teofan/input/
tools/translate_Teofan/work/

# „От оптинските старци" — извън git остават и работната папка (509 файла,
# 16 MB: разглобяването, подборът и 400-те превода), и входните книги.
#
# Книгите са вън по АВТОРСКИ съображения, не заради тежест. Текстовете на
# старците са от XIX век и са обществено достояние, но съставителството на
# „Симфонията" (Т. Н. Терещенко, 2009) и самото .epub издание не са. Онова,
# което разпространяваме, е нашият превод на отделни цитати — не чуждото
# издание. Същото важи и за Теофановата книга по-горе.
#
# В git остават САМО скриптовете и README — с тях всичко се възпроизвежда,
# стига книгите да са налице в input/.
#
# ⚠ Книгите не се пазят никъде другаде. Изтрие ли се `input/`, конвейерът
# не може да се пусне наново, колкото и да са запазени скриптовете.
tools/translate_Optina/input/
tools/translate_Optina/work/

# Работната папка на предишния конвейер (azbyka.ru) — 840 MB свалени
# страници, работни файлове и ключът към DeepSeek. Пренесена в проекта на
# 16.08.2026, за да е на едно място с останалите инструменти, но НЕ влиза в
# git: тежка е, съдържа чуждо съдържание и е производна.
tools/azbyka.ru/

# Свързване на житията по Димитрий Ростовски със saints по (дата + прилика
# на име) — нов инструмент, все още в начален етап. Цялата папка е извън
# git засега, по изрична молба на потребителя, докато работата се
# стабилизира (тогава ще се прецени дали скриптовете да влязат, по
# образеца на останалите конвейери в tools/).
tools/match_dmitry_lives/

# Свещеното Писание за секцията „Библия" — в git остават САМО скриптовете и
# картите в input/ (книги, глави, езици — леки CSV-та, от които всичко се
# възпроизвежда). Извън него са:
#   cache/  — свалените HTML страници, 1361 глави × 12 езика ≈ 500 MB;
#   output/ — разглобяването в JSON и готовата база.
# И двете са производни: изтрият ли се, конвейерът ги прави наново — само че
# cache/ иска ~10 часа мрежа, тъй че не го трий без нужда.
tools/bible_gen/cache/
tools/bible_gen/output/

# Архивите с резервните копия, които tools/corrections/apply.py прави преди запис
tools/corrections/backups/

# Обща мрежа за единичните резервни копия `<файл>.bak-ГГГГММДД_ЧЧММСС`,
# които правят и други скриптове преди запис (calendar_gen, azbyka.ru,
# tools/fonts/) — не само tools/corrections/. Трият се на ръка след
# проверка; редът тук пази от случайно закачане, ако някой бъде забравен.
*.bak-*

# Дисертация (PDF, 2,5 MB) — чужд научен труд, оставен тук за справка при
# издирване на български светии, които календарът още няма. Не е част от
# приложението и не бива да пътува в хранилището: правата са на автора.
tools/dissertation/

# Жития на български светии от сайта на Софийска света митрополия
# (mitropolia-sofia.org, поредицата „Кръстният подвиг на българските светии").
# Втори извор след tools/lives_bg/ — там го няма Тервел, Райко Шуменски и
# още десетина. Извън git по същите съображения: свалени чужди страници и
# производни от тях.
tools/lives_mitropolia/

# Единични находки от разни сайтове — жития и възпоменания, каквито няма нито
# в pravoslavieto.com, нито при митрополията. Всеки извор е СВОЙ сайт, тъй че
# тук няма указател: работи се по ръчен списък адреси (input/sources.csv).
tools/lives_extra/

# Тестовете.
#
# ⚠ Поводът е `test/
# ⚠ ИЗКЛЮЧЕНИЕ: този тест пази устойчивостта на адресирането на цитати —
# единственото, което НЕ БИВА да се счупи, защото споделени линкове живеят
# на чужди телефони. Няма фикстури и не носи чужд текст, тъй че съображението
# за правата не важи за него.
!test/quote_link_test.dartfixtures/lives_sample.json` — 380 KB, в които стоят
# 210 000 знака ЖИТИЯ, извадени от `lives.db` за проверка на PDF оформлението.
# Хранилището е ПУБЛИЧНО (и трябва да остане такова — библейските езикови
# пакети се теглят анонимно от изданието `bible-packs-v1`), а правата върху
# тези текстове още не са уредени: разговорът с pravoslavieto.com предстои.
# Досега целият чужд текст стоеше извън git по същото съображение — базите,
# томовете, четирите конвейера. Фикстурът щеше да е първото изключение, и то
# точно преди разговора.
#
# ⚠ Съдържанието не е нужно на самия тест — той мери оформление и му трябва
# само реален обем и структура. Пресъздава се от базата с командата, записана
# в началото на `test/pdf_layout_test.dart`.
#
# ⚠ `widget_test.dart` и `search_match_test.dart` ВЕЧЕ СА в git и този ред НЕ
# ги маха — git не спира да следи файл, който вече проследява. Така и трябва:
# вторият пази търсенето по ключови думи (виж CLAUDE.md, „Търсенето е по
# КЛЮЧОВИ ДУМИ"). Редът тук пази само от НОВИ файлове в папката.
test/

# ⚠ Паролата на подписващия ключ. НИКОГА в git — с нея всеки може да подпише
# APK от твое име, а Play го приема за твой ъпдейт.
# Самият .jks файл живее ИЗВЪН хранилището (Documents/…/AppKey/).
android/key.properties
